# =============================================================================
# Configuracoes gerais do servidor
# =============================================================================
PORT=4000
NODE_ENV=development

# Origem permitida para requisicoes CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# GLPI - REST API
# =============================================================================
# URL base da API REST do GLPI (geralmente termina em /apirest.php)
GLPI_API_URL=http://localhost/glpi/apirest.php

# Token de aplicacao gerado em Configurar > Geral > API
GLPI_APP_TOKEN=informe_o_app_token_aqui

# Token de usuario gerado no perfil do usuario de servico (Preferencias > API)
GLPI_USER_TOKEN=informe_o_user_token_aqui

# ID do campo de busca (search option) usado para localizar usuario por email
# no itemtype "User". O valor padrao (5) corresponde ao campo "Email" na
# maioria das instalacoes padrao do GLPI.
GLPI_SEARCH_FIELD_EMAIL=5

# =============================================================================
# DocuSign - eSignature API
# =============================================================================
# Ambiente de demonstracao (sandbox) ou producao
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_AUTH_SERVER=account-d.docusign.com

# Integration Key (Client ID) do aplicativo cadastrado no DocuSign
DOCUSIGN_INTEGRATION_KEY=informe_a_integration_key_aqui

# User ID (GUID) do usuario impersonado para o fluxo JWT Grant
DOCUSIGN_USER_ID=informe_o_user_id_aqui

# ID da conta DocuSign (Account ID)
DOCUSIGN_ACCOUNT_ID=informe_o_account_id_aqui

# Caminho para a chave privada RSA usada na autenticacao JWT
DOCUSIGN_PRIVATE_KEY_PATH=./docusign_private_key.pem

# Nome exibido como remetente do envelope
DOCUSIGN_BRAND_NAME=Sua Empresa

# =============================================================================
# Banco de dados
# =============================================================================
# Caminho do arquivo SQLite
DATABASE_PATH=./data/database.sqlite
